// Official ACG720-138&60K common pin table: GPIO0_14 = C14.
// This is a signal number, NOT physical connector pin 14. Bank must be 3.3 V.
IO_LOC "control_rx" C14;
IO_PORT "control_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc1_a" E14;
IO_LOC "enc1_b" C13;
IO_LOC "enc2_a" B13;
IO_LOC "enc2_b" D14;
IO_PORT "enc1_a" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "enc1_b" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "enc2_a" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "enc2_b" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// ACG720 official pin table: board infrared receiver IR -> F21, LVCMOS33.
IO_LOC "ir_rx" F21;
IO_PORT "ir_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// Official ACG720-138&60K pin table: GPIO0_16 = B15.
// User confirmed B15 is free. C14 and C15 are reserved for RK3588.
IO_LOC "bt_rx" B15;
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

